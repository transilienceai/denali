# Local mode. Production Modal forces DENALI_AUTH_MODE=clerk.
DENALI_AUTH_MODE=local
DENALI_DSN=postgresql://denali:denali-local@127.0.0.1:55450/denali
DENALI_TENANT_ID=00000000-0000-4000-8000-000000000001
DENALI_WEB_URL=http://127.0.0.1:3080
DENALI_CORS_ORIGINS=http://localhost:5173

# Hosted Clerk configuration (backend only unless prefixed VITE_).
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=https://denali.example.com
DENALI_CLERK_ORGANIZATIONS=
VITE_CLERK_PUBLISHABLE_KEY=

# Hosted Postgres. Use Neon's pooler for runtime and direct endpoint for migrations.
DENALI_MIGRATION_DSN=

# Vercel build-time API origin, for example https://workspace--denali-production-api.modal.run
MODAL_API_ORIGIN=

# Modal deployment identity, placement, and optional AWS OIDC role.
DENALI_MODAL_APP_NAME=denali-production
DENALI_MODAL_REGION=
DENALI_MODAL_SECRET_NAME=denali-production
DENALI_MODAL_PROVIDER_SECRET_NAME=
DENALI_MODAL_AWS_ROLE_ARN=

# Provider onboarding configuration.
DENALI_AWS_ONBOARDING_BUCKET=
DENALI_AWS_PRINCIPAL_ARN=
DENALI_AZURE_ONBOARDING_BUCKET=
DENALI_AZURE_CLIENT_ID=
DENALI_AZURE_CLIENT_SECRET=
DENALI_AZURE_CONSENT_REDIRECT_URI=
DENALI_ENTRA_CLIENT_ID=
DENALI_ENTRA_CLIENT_SECRET=
DENALI_ENTRA_CALLBACK_URL=
DENALI_GCP_ONBOARDING_BUCKET=
DENALI_GCP_OPERATOR_PROJECT_ID=
DENALI_GCP_WORKLOAD_IDENTITY_PROVIDER=
DENALI_GCP_RUNTIME_SERVICE_ACCOUNT=
DENALI_GITHUB_APP_ID=
DENALI_GITHUB_CLIENT_ID=
DENALI_GITHUB_CLIENT_SECRET=
DENALI_GITHUB_APP_SLUG=
DENALI_GITHUB_PRIVATE_KEY=
DENALI_GITHUB_CALLBACK_URL=
